from collections.abc import (
    ItemsView as _ItemsView,
)
from collections.abc import (
    Iterable,
    Iterator,
    MutableMapping,
    MutableSequence,
)
from collections.abc import (
    KeysView as _KeysView,
)
from collections.abc import (
    ValuesView as _ValuesView,
)
from typing import Any, TypeVar, overload

from typing_extensions import Self, override

_T = TypeVar("_T")

class KeysView(_KeysView[str]):
    def __reversed__(self) -> Iterator[str]: ...
    @override
    def __eq__(self, other: object) -> bool: ...

class ValuesView(_ValuesView[Item]):
    @override
    def __contains__(self, value: object) -> bool: ...
    @override
    def __eq__(self, other: object) -> bool: ...

class ItemsView(_ItemsView[str, Item]):
    @override
    def __contains__(self, item: object) -> bool: ...
    @override
    def __eq__(self, other: object) -> bool: ...

class Document(MutableMapping[str, Any]):
    def __init__(self, data: dict[str, Any] | None = None) -> None: ...
    @staticmethod
    def parse(text: str) -> Document: ...
    @override
    def __iter__(self) -> Iterator[str]: ...
    @override
    def __len__(self) -> int: ...
    def __bool__(self) -> bool: ...
    @override
    def __eq__(self, other: object) -> bool: ...
    @override
    def __getitem__(self, key: str) -> Item: ...
    @override
    def __setitem__(self, key: str, value: Any) -> None: ...
    @override
    def __delitem__(self, key: str) -> None: ...
    @override
    def keys(self) -> KeysView: ...
    @override
    def items(self) -> ItemsView: ...
    @override
    def values(self) -> ValuesView: ...
    @overload
    @override
    def get(self, key: str, /) -> Item | None: ...
    @overload
    def get(self, key: str, default: _T, /) -> Item | _T: ...
    @overload
    @override
    def setdefault(self, key: str, default: None = None, /) -> Item: ...
    @overload
    def setdefault(self, key: str, default: Any, /) -> Item: ...
    def fmt(self) -> None: ...
    def __copy__(self) -> Document: ...
    def __deepcopy__(self, memo: dict[int, Any] | None = None) -> Document: ...
    @property
    def value(self) -> dict[str, Any]: ...

class Item:
    @staticmethod
    def parse(text: str) -> Item: ...
    @overload
    def __getitem__(self, key: str | int) -> Item: ...
    @overload
    def __getitem__(self, key: slice) -> list[Item]: ...
    def __setitem__(self, key: str | int | slice, value: Any) -> None: ...
    def __delitem__(self, key: str | int | slice) -> None: ...
    def __len__(self) -> int: ...
    def __iter__(self) -> Iterator[Any]: ...
    def __contains__(self, value: Any) -> bool: ...
    def __bool__(self) -> bool: ...
    @override
    def __eq__(self, other: object) -> bool: ...
    def __iadd__(self, values: Iterable[Any]) -> Self: ...
    @property
    def value(self) -> Any: ...
    @property
    def comment(self) -> str | None: ...
    @comment.setter
    def comment(self, value: str | None) -> None: ...
    @property
    def inline_comment(self) -> str | None: ...
    @inline_comment.setter
    def inline_comment(self, value: str | None) -> None: ...
    # dict-like methods
    def keys(self) -> KeysView: ...
    def values(self) -> ValuesView: ...
    def items(self) -> ItemsView: ...
    @overload
    def get(self, key: str, /) -> Item | None: ...
    @overload
    def get(self, key: str, default: _T, /) -> Item | _T: ...
    def pop(self, *args: Any) -> Any: ...
    def update(self, *args: Any, **kwargs: Any) -> None: ...
    def setdefault(self, key: str, default: Any = ..., /) -> Item: ...
    # list-like methods
    def append(self, value: Any, /) -> None: ...
    def insert(self, index: int, value: Any, /) -> None: ...
    def remove(self, value: Any, /) -> None: ...
    def extend(self, values: Iterable[Any], /) -> None: ...
    def count(self, value: Any, /) -> int: ...
    def index(self, value: Any, start: int = ..., stop: int = ..., /) -> int: ...
    # shared
    def clear(self) -> None: ...
    def fmt(self) -> None: ...

class DictItem(Item, MutableMapping[str, Any]):
    @override
    def __iter__(self) -> Iterator[str]: ...
    @override
    def keys(self) -> KeysView: ...
    @override
    def values(self) -> ValuesView: ...
    @override
    def items(self) -> ItemsView: ...
    @overload
    @override
    def get(self, key: str, /) -> Item | None: ...
    @overload
    def get(self, key: str, default: _T, /) -> Item | _T: ...
    @override
    def setdefault(self, key: str, default: Any = ..., /) -> Item: ...

class ListItem(Item, MutableSequence[Any]):
    @override
    def insert(self, index: int, value: Any, /) -> None: ...

class ScalarItem(Item): ...
